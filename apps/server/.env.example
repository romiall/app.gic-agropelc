# Copier en .env (ignoré par git) pour le développement local. Aucun secret réel ici.

NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Connexion applicative : identifiants gic_app (privilèges minimaux par table, db/README.md
# §1), DISTINCTS de DATABASE_URL (admin, migrations — db:migrate/db:seed).
SERVER_DATABASE_URL=mysql://gic_app:<mot-de-passe-local>@127.0.0.1:3306/gic_agropelc_dev

# Paire ES256 (07-security-rbac/02-securite.md §3), format PEM. Optionnelles en
# development/test : une paire éphémère est générée en mémoire si absentes (voir
# src/modules/identity/jwt-keys.provider.ts) — jamais de clé figée dans le dépôt.
# Obligatoires si NODE_ENV=production (env.ts lève une erreur au démarrage sinon).
# JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
